# Example environment variables. Copy to .env and fill in real values.
JWT_SECRET=your_jwt_secret_here
MONGODB_URI=your_mongodb_connection_string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# MongoDB Atlas connection string
# Replace <username>, <password>, and <dbName> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yil9toj.mongodb.net/<dbName>?retryWrites=true&w=majority&appName=Cluster0

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the Express/Socket.IO server listens on
PORT=4000

# Origin allowed to talk to this server (your frontend dev URL)
CLIENT_ORIGIN=http://localhost:5173
